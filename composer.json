{
  "authors": [
    {
      "email": "tomaschochola@tomaschochola.cz",
      "homepage": "https://github.com/tomaschochola",
      "name": "Tomáš Chochola",
      "role": "Author"
    }
  ],
  "autoload": {
    "psr-4": {
      "TomasChochola\\Psr\\Http\\Client\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": false,
    "platform-check": true,
    "policy": {
      "abandoned": {
        "audit": "fail",
        "block": true
      },
      "advisories": {
        "audit": "fail",
        "block": true
      },
      "malware": {
        "audit": "fail",
        "block": true
      }
    },
    "sort-packages": true
  },
  "description": "cURL-backed PSR-18 HTTP client implementation.",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/tomaschochola"
    }
  ],
  "homepage": "https://github.com/tomaschochola/php-psr-18-http-client-curl",
  "keywords": [
    "tomaschochola",
    "TomasChochola",
    "Tomas Chochola",
    "Tomáš Chochola",
    "curl",
    "http",
    "http-client",
    "psr-18"
  ],
  "license": "CC-BY-ND-4.0",
  "name": "tomaschochola/php-psr-18-http-client-curl",
  "prefer-stable": true,
  "provide": {
    "psr/http-client-implementation": "1.0"
  },
  "repositories": [
    {
      "no-api": true,
      "type": "vcs",
      "url": "https://github.com/tomaschochola/php-psr-7-http-message.git"
    },
    {
      "no-api": true,
      "type": "vcs",
      "url": "https://github.com/tomaschochola/php-psr-17-http-factory.git"
    },
    {
      "no-api": true,
      "type": "vcs",
      "url": "https://github.com/tomaschochola/php-psr-18-http-client.git"
    },
    {
      "no-api": true,
      "type": "vcs",
      "url": "https://github.com/tomaschochola/tooling-php-cs-fixer.git"
    },
    {
      "no-api": true,
      "type": "vcs",
      "url": "https://github.com/tomaschochola/tooling-phpstan.git"
    }
  ],
  "require": {
    "ext-curl": "*",
    "ext-mbstring": "*",
    "php": "^8.5.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "tomaschochola/php-psr-18-http-client": "dev-main"
  },
  "require-dev": {
    "ext-intl": "*",
    "ext-pcntl": "*",
    "ext-xdebug": "*",
    "ext-zip": "*",
    "phpunit/phpunit": "^13.0",
    "roave/security-advisories": "dev-latest",
    "tomaschochola/php-psr-17-http-factory": "dev-main",
    "tomaschochola/php-psr-7-http-message": "dev-main",
    "tomaschochola/tooling-php-cs-fixer": "dev-main",
    "tomaschochola/tooling-phpstan": "dev-main"
  },
  "support": {
    "email": "tomaschochola@tomaschochola.cz",
    "issues": "https://github.com/tomaschochola/php-psr-18-http-client-curl/issues",
    "source": "https://github.com/tomaschochola/php-psr-18-http-client-curl.git"
  },
  "type": "library"
}
