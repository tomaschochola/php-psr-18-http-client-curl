    "psr/http-message": "^2.0",
    "tomaschochola/php-psr-18-http-client": "^1.0@dev"
  },
  "require-dev": {
    "ext-intl": "*",
    "ext-pcntl": "*",
    "ext-xdebug": "*",
    "ext-zip": "*",
    "phpunit/phpunit": "^12.5",
    "roave/security-advisories": "dev-latest",
    "tomaschochola/php-cs-fixer-stack": "^1.0@dev",
    "tomaschochola/phpstan-stack": "^1.0@dev"
