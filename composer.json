    "process-timeout": 0,
    "sort-packages": true
  },
  "description": "tomaschochola/php-psr-18-http-client-curl",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/tomaschochola"
    }
  ],
  "homepage": "https://github.com/tomaschochola/php-psr-18-http-client-curl",
  "keywords": [
    "tomaschochola",
    "TomasChochola",
    "Tomas Chochola",
    "Tomáš Chochola",
    "php-psr-18-http-client-curl"
  ],
  "license": "CC-BY-ND-4.0",
  "minimum-stability": "dev",
  "name": "tomaschochola/php-psr-18-http-client-curl",
  "prefer-stable": true,
  "readme": "./README.md",
  "repositories": [
    {
      "no-api": true,
      "type": "git",
      "url": "https://github.com/tomaschochola/phpstan-stack.git"
    },
    {
      "no-api": true,
      "type": "git",
      "url": "https://github.com/tomaschochola/php-cs-fixer-stack.git"
    },
    {
      "no-api": true,
      "type": "git",
      "url": "https://github.com/tomaschochola/php-psr-18-http-client.git"
    }
  ],
  "require": {
    "ext-curl": "*",
    "ext-mbstring": "*",
